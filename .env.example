# Database (External PostgreSQL)
DATABASE_URL=postgresql://aiuser:aipassword@postgres:5432/aigenerator?schema=public
DB_HOST=postgres
DB_PORT=5432
DB_USER=aiuser
DB_PASSWORD=aipassword
DB_NAME=aigenerator

# Redis
REDIS_URL=redis://redis:6379

# OpenRouter API (Required for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Bitrix24 OAuth2 (Optional - for CRM integration)
BITRIX24_CLIENT_ID=your_bitrix_client_id
BITRIX24_CLIENT_SECRET=your_bitrix_client_secret
BITRIX24_REDIRECT_URI=http://localhost:3000/bitrix/callback
BITRIX_TOKEN=your_bitrix_access_token
BITRIX_DOMAIN=your-company.bitrix24.com

# Security (Change these in production!)
ENCRYPTION_KEY=your-32-character-secret-key-change-me
WEBHOOK_SECRET=your-webhook-secret-change-me

# App Configuration
NODE_ENV=development
PORT=3000
STORAGE_PATH=/app/storage

# S3/MinIO Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password_change_me
S3_BUCKET=bx-images

# Worker Configuration
WORKER_CONCURRENCY=2

# Frontend
VITE_API_URL=/api

# Cloudflare Tunnel (Optional - for webhook testing)
# Get token from: cloudflared tunnel token --cred-file /tmp/cred.json your-tunnel-name
CLOUDFLARE_TUNNEL_TOKEN=

# Ngrok (Alternative to Cloudflare - optional)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
